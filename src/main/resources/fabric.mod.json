{
	"schemaVersion": 1,
	"id": "respawn-anchor-help",
	"version": "${version}",
	"name": "Respawn Anchor Help",
	"description": "Client-side combat QoL: switches back to your respawn anchor after charging it with glowstone, and hides explosion and totem particles. Everything is toggleable.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/respawn-anchor-help/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"respawn.anchor.help.RespawnAnchorHelp"
		],
		"client": [
			"respawn.anchor.help.client.RespawnAnchorHelpClient"
		],
		"modmenu": [
			"respawn.anchor.help.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"respawn-anchor-help.mixins.json",
		{
			"config": "respawn-anchor-help.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.9.0"
	},
	"recommends": {
		"modmenu": "*"
	}
}
